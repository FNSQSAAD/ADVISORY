{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.fnsq.com.au"
        }
      ],
      "destination": "https://fnsq.com.au/$1",
      "permanent": true
    },
    {
      "source": "/book-a-free-strategy-call",
      "destination": "https://api.leadconnectorhq.com/widget/booking/jjntJeKyOuid8eFZkm7W",
      "permanent": false
    },
    {
      "source": "/book-a-free-strategy-call/",
      "destination": "https://api.leadconnectorhq.com/widget/booking/jjntJeKyOuid8eFZkm7W",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
